# campaign-proposal — variables OPTIONNELLES. À copier dans un .env local (jamais commité)
# ou à exporter dans ton shell. Toutes ont un équivalent CLI dans assets/build_proposal.py.

# Racine de tes dossiers clients ({PROJECT_DIR}/{client}/03-campaign-proposal/)
PROJECT_DIR=~/clients

# --- Branding du PDF (défaut neutre si absent) ---
# Nom de l'agence : footer "<nom> — Confidentiel" + remplace {{AGENCY_NAME}} dans le markdown
AGENCY_NAME=Acme Agence
# Logo PNG/JPG (couverture + filigrane). Sans logo → couverture texte seule.
AGENCY_LOGO=~/path/to/logo.png
# Couleurs "#PRIMAIRE,#SOMBRE" (H2 + lignes, H1)
AGENCY_BRAND=#4A7FD4,#1E2A4A
# Baseline affichée en bas de la couverture
AGENCY_TAGLINE=Acquisition Meta Ads

# --- Phase 6 OPTIONNELLE : injection dans ta propre base Supabase ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
