# client-onboarding-flow — variables uniquement nécessaires à l'étape OPTIONNELLE de persistance (assets/inject_to_database.py)
# Dossier racine où vivent tes dossiers clients (utilisé dans les prompts de l'orchestrateur)
PROJECT_DIR=~/clients
# Ton projet Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Clé service_role (PAS l'anon key) — jamais dans un repo
SUPABASE_SERVICE_ROLE_KEY=
