# meta-lead-notifications — copier vers ~/.config/meta-lead-notifications/<client>.env (chmod 600)
# Token Meta System User (non-expirant), scopes leads_retrieval + pages_manage_ads
META_ACCESS_TOKEN=
# Token bot Slack avec le scope chat:write ; le bot doit être membre du channel
SLACK_TOKEN=xoxb-...
# ID du channel Slack (Cxxxxxxxx), pas son nom
SLACK_CHANNEL=
# ID de la Page Facebook du client
PAGE_ID=
# ID(s) du/des formulaire(s) Lead Ads, séparés par des virgules
FORM_IDS=
# Nom affiché dans l'en-tête du message Slack
CLIENT_NAME="Acme Fermetures"
# Fichier d'état (leads déjà notifiés) — créé automatiquement
STATE_FILE=~/.local/state/meta-lead-notifications/acme/seen-leads.json

# --- Annexe slack_watch_ghl_key.py (optionnel) ---
# SLACK_WATCH_CHANNEL=
# GHL_WATCH_STATE=~/.local/state/meta-lead-notifications/acme/ghl-watch.json
# GHL_KEY_OUT=~/.local/state/meta-lead-notifications/acme/ghl-key.json
