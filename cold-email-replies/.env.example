# Noms des variables seulement. Posez les valeurs dans l'environnement du serveur, jamais dans un fichier commité.

# Interrupteur : absent ou 0, l'agent ne fait rien.
REPLY_AGENT_ENABLED=
# Fichier SQLite de l'état, sur un disque persistant.
REPLY_AGENT_DB=
# Chemin de la configuration JSON (défaut : ./config.json).
REPLY_AGENT_CONFIG=

# Outil d'envoi
SMARTLEAD_API_KEY=
SMARTLEAD_CAMPAIGN_IDS=

# Classeur de production (classifier.mode = claude)
ANTHROPIC_API_KEY=

# Générateur du livrable (deliverable.mode = webhook)
DELIVERABLE_API_URL=
DELIVERABLE_API_KEY=

# Alertes de l'équipe (webhook entrant)
SLACK_WEBHOOK_URL=

# Pipeline du CRM
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Lien de réservation, s'il n'est pas dans la configuration
BOOKING_URL=
