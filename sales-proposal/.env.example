# Aucune clé API n'est nécessaire. Ces variables servent uniquement au rendu PDF
# (scripts/render.cjs). Exportez-les dans votre shell : aucun script ne lit de fichier .env.

# Module Playwright existant, si Playwright n'est pas installé à côté du skill
PLAYWRIGHT_MODULE=

# Navigateur précis (Chrome, Chromium, Edge), facultatif
CHROME_PATH=
